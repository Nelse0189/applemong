# Create a "script" app at https://www.reddit.com/prefs/apps
# The client id is the string under the app name. The secret is labeled "secret".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# If the account uses two-factor auth, append the current code: password:123456
# Optional. Defaults to: script:reddit-upload:0.1 (by /u/REDDIT_USERNAME)
REDDIT_USER_AGENT=
